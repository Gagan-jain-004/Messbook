datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AttendanceStatus {
  Taken
  Skipped
  NotMarked
}

enum FeedbackStatus {
  Pending
  Resolved
}

model User {
  id        String   @id @default(uuid())
  clerkId   String?  @unique
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  attendance Attendance[]
  feedback   Feedback[]

  @@index([clerkId])
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  date      DateTime
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String
  message   String
  status    FeedbackStatus @default(Pending)
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
